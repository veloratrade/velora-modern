# apps/web image — W5 frontend delivery (ADR-010/D-15), same discipline as
# Dockerfile.api: multi-stage, non-root runtime, no secrets in the image.
#
# GOVERNANCE: DEV/STAGING ONLY until Gate 3B pins base digests (registry
# evidence) — same deferral as Dockerfile.api/worker. Never claims production.
#
# Build:  docker build -f infra/Dockerfile.web -t velora-web .
# Run:    docker run -e VELORA_API_ORIGIN=http://api:8080 -p 3000:3000 velora-web
#
# The browser only ever talks same-origin: page loads come from this container,
# /api/* is rewritten to VELORA_API_ORIGIN inside Next (next.config.ts), so no
# CORS and no direct browser→API coupling (ADR-010). CSP/nonce/locale all come
# from src/proxy.ts at request time — no build-time origin baking.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/ packages/
COPY apps/ apps/
RUN npm ci
# next build must see the workspace graph; output stays inside apps/web/.next
RUN npm run build --workspace=@velora/web

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Full /app is copied (workspace node_modules + .next) — same shape as
# Dockerfile.api; slimming to a pruned deploy image is a Gate 3B checklist item.
COPY --from=build /app /app
USER node
EXPOSE 3000
# Liveness on a real page (proxy runs there too); /api stays internal.
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"
# next.config rewrites /api/* → ${VELORA_API_ORIGIN:-http://127.0.0.1:8080}
CMD ["npm", "run", "start", "--workspace=@velora/web"]
