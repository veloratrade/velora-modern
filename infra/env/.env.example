# Copy to .env and fill values locally. THIS FILE MUST CONTAIN NO REAL VALUES.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
API_ALLOWED_ORIGINS=
# Environment identity + application origin (ADR-013) — explicit, never defaulted.
# APP_ENV must be exactly: development | staging | production (anything else is invalid).
# APP_ORIGIN must be a bare https origin for this environment (no path/query/fragment).
APP_ENV=
APP_ORIGIN=

# --- Canonical origins (ADR-013 EO-008/EO-009) -------------------------------
# Comma-separated. The boot gate BLOCKS a staging/production start when the
# environment's canonical origin set is empty, and blocks again when APP_ORIGIN
# is not a member of it. These are declarations of an owner decision, not
# defaults — ADR-013 OD-1 is still OPEN for staging.
CANONICAL_STAGING_ORIGINS=
CANONICAL_PRODUCTION_ORIGINS=

# --- Persistence -------------------------------------------------------------
# PERSISTENCE must be 'postgres' outside development (SC-004/SC-006).
PERSISTENCE=
# Runtime connection used by the API. MUST be the least-privilege runtime role
# (app_readwrite) — never the bootstrap/superuser and never the migrator.
DATABASE_URL=
# Session/token signing secret. Never committed; provisioned per environment.
JWT_SECRET=
PORT=

# --- Privilege provisioning (db/provision.ts) --------------------------------
# Used ONLY by the deploy-time provisioning step, never by the running API.
#
# ADMIN_DATABASE_URL  : bootstrap/superuser connection. On Railway this is the
#                       service-provided POSTGRES_USER, which the official
#                       postgres image creates via `initdb --username=` and is
#                       therefore a real superuser (so it has CREATEROLE).
# ADMIN_DATABASE_ROLE : the role NAME of that connection (e.g. postgres).
# MIGRATION_DATABASE_URL : the migrator identity. Must carry the owner role
#                       per-connection by appending the query parameter
#                         ?options=-c%20role%3Dvelora_owner
#                       to the velora_migrator connection string (userinfo is
#                       supplied by the platform secret store, never written
#                       here — a literal example URL with credentials would be
#                       flagged by tools/secret-scan.sh, correctly).
#                       Scoping it here (not via a service-wide PGOPTIONS) keeps
#                       the API/worker runtime unable to assume the owner role.
ADMIN_DATABASE_URL=
ADMIN_DATABASE_ROLE=
MIGRATION_DATABASE_URL=

# --- Transactional email (Phase 3B-1, OD-12) ---------------------------------
# Resend is the only provider. The adapter FAILS CLOSED when the key is absent:
# it never falls back to another transport and never silently drops mail.
# Provision the value through the platform secret store — never write it here.
RESEND_API_KEY=
