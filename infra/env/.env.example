# Copy to .env and fill values locally. THIS FILE MUST CONTAIN NO REAL VALUES.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
API_ALLOWED_ORIGINS=
# Environment identity + application origin (ADR-013) — explicit, never defaulted.
# APP_ENV must be exactly: development | staging | production (anything else is invalid).
# APP_ORIGIN must be a bare https origin for this environment (no path/query/fragment).
APP_ENV=
APP_ORIGIN=
