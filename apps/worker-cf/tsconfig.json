{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["es2024"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../api/src/**/*.ts", "../../packages/*/src/**/*.ts"],
  "exclude": ["**/*.test.ts", "../api/src/**/*.test.ts", "../api/src/**/__fixtures__/**", "dist"]
}
