{
  "name": "@velora/worker-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers host for the existing Velora Telegram bot. Reuses apps/api modules; adds no new bot logic.",
  "scripts": {
    "types": "tsc -p tsconfig.json --noEmit",
    "bundle": "wrangler deploy --dry-run --outdir dist -c wrangler.jsonc",
    "dev": "wrangler dev -c wrangler.jsonc --local --port 8787",
    "it": "tsx scripts/integration.mjs",
    "test": "tsx --test src/*.test.ts",
    "lp": "tsx scripts/leastPrivilege.mjs"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
