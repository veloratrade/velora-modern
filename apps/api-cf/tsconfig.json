{
  // Mirrors apps/worker-cf: this host compiles the API's SOURCES directly (there is no built package to
  // import), which is what keeps "one kernel, two hosts" true rather than aspirational. Excluding tests
  // keeps this gate about production code; the tests run under tsx with their own runner.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["es2024"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../api/src/**/*.ts", "../worker-cf/src/**/*.ts", "../../packages/*/src/**/*.ts"],
  "exclude": ["**/*.test.ts", "../api/src/**/*.test.ts", "../worker-cf/src/**/*.test.ts", "../api/src/**/__fixtures__/**", "dist"]
}
