{
  "schema": "velora-migration-decisions/1",
  "synthetic": true,
  "note": "FIXTURE ONLY. These mappings exist so the rehearsal harness's MAPPED and QUARANTINE paths are exercised end to end. A real export needs its own decisions file, and the time decision must be the owner's (ADR-004 sampling) \u2014 never a default copied from here.",
  "source_vocabulary": {
    "auto_sync": {
      "to": "metaapi",
      "basis": "GAP-03 / OD-15 \u2014 legacy `auto_sync` means the MetaAPI sync job produced the row; the target CHECK accepts manual|metaapi|import"
    }
  },
  "symbol_canonicalisation": {
    "XAU/USD": {
      "to": "XAUUSD",
      "basis": "GAP-15 \u2014 slash forms are rewritten to the canonical broker symbol; contract size is taken from the row, never inferred"
    }
  },
  "locale_vocabulary": {
    "fa": {
      "to": "fa",
      "basis": "GAP-04 \u2014 legacy and modern vocabularies already agree for fa/en"
    },
    "en": {
      "to": "en",
      "basis": "GAP-04"
    }
  },
  "leverage_rule": {
    "empty": "100",
    "basis": "GAP-05 \u2014 target is NOT NULL DEFAULT '100'; an empty legacy leverage becomes the documented default, not a guess"
  },
  "time": {
    "mode": "given_utc_only",
    "resolves_unresolved_rows": false,
    "basis": "ADR-004 \u2014 the naive-datetime sampling decision is OUTSTANDING, so rows with no offset-explicit instant are quarantined (UNRESOLVED_TIME) rather than interpreted"
  },
  "field_mapping": {
    "users": {
      "id": {
