{
  "name": "velora-modern",
  "version": "0.1.0",
  "private": true,
  "description": "Velora modern architecture foundation (Phase 1 — dev/staging only)",
  "type": "module",
  "engines": { "node": ">=20 <23" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "tsc -b packages/contracts packages/domain packages/config",
    "typecheck": "tsc -b packages/contracts packages/domain packages/config apps/api apps/worker apps/web",
    "test": "node tools/run-tests.mjs",
    "test:migrations": "tsx --test db/tests/migrations.test.ts",
    "secret-scan": "bash tools/secret-scan.sh",
    "migrate:dev": "tsx db/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
